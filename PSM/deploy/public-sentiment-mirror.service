[Unit]
Description=Public Sentiment Mirror Streamlit App
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/public-sentiment-mirror
ExecStart=/opt/public-sentiment-mirror/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

